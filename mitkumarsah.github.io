font-size:20px;
margin-top:10px;
}

.btn{
margin-top:30px;
padding:14px 28px;
background:#4ea3ff;
color:white;
text-decoration:none;
border-radius:8px;
font-weight:bold;
}

nav{
position:sticky;
top:0;
background:#061220;
padding:15px;
text-align:center;
z-index:1000;
}

nav a{
color:white;
text-decoration:none;
margin:0 18px;
font-weight:bold;
}

section{
max-width:1000px;
margin:auto;
padding:70px 25px;
}

h2{
color:#4ea3ff;
margin-bottom:20px;
font-size:34px;
}

.card{
background:#0f1d2d;
