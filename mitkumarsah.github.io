body{
background:#08111f;
color:white;
scroll-behavior:smooth;
}

header{
height:100vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
background:linear-gradient(135deg,#071a35,#1565c0);
padding:20px;
}

header img{
width:170px;
height:170px;
border-radius:50%;
border:5px solid white;
object-fit:cover;
}

